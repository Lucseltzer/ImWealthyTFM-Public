# Allowlist for a clean public repository. Runtime output is excluded by default.
*
!.gitignore
!.gitattributes
!LICENSE
!NOTICE.md
!README.md
!requirements.txt
!requirements-dev.txt
!requirements-forecast.txt
!app.py
!market.py
!forecast.py
!generate_forecast.py
!simulator.py
!live_chart.py
!lightweight-charts.standalone.production.js
!lightweight-charts.LICENSE
!lightweight-charts.NOTICE
!lwc-plugin-hlc-area-series.standalone.js
!lwc-plugin-hlc-area-series.LICENSE
!lwc-plugin-hlc-area-series.NOTICE.md
!THIRD_PARTY_NOTICES.md
!tests/
!tests/*.py
!.streamlit/
!.streamlit/config.toml
!.github/
!.github/workflows/
!.github/workflows/ci.yml
